{
  "repo": "openclaw/openclaw",
  "githubToken": "",
  "outputDir": "./output",
  "updateSchedule": "0 0 * * *",
  "fetchDetailed": false,
  "weights": {
    "commit": 10,
    "prMerged": 50,
    "prCreated": 20,
    "issue": 10,
    "review": 15,
    "comment": 2
  },
  "tiers": {
    "founder": { "min": 50000, "label": "Founder" },
    "elite": { "min": 3000, "label": "elite Builder" },
    "veteran": { "min": 500, "label": "veteran Contributor" },
    "active": { "min": 100, "label": "active Contributor" },
    "member": { "min": 0, "label": "Member" }
  },
  "achievements": {
    "centurion": { "type": "commits", "threshold": 100, "label": "Centurion" },
    "marathonCoder": { "type": "commits", "threshold": 500, "label": "Marathon Coder" },
    "commitLegend": { "type": "commits", "threshold": 1000, "label": "Commit Legend" },
    "merger": { "type": "prMerged", "threshold": 5, "label": "Merger" },
    "conversationalist": { "type": "comments", "threshold": 20, "label": "Conversationalist" }
  }
}
